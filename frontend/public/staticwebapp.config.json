{
  "navigationFallback": {
    "rewrite": "/index.csr.html",
    "exclude": [
      "/images/*",
      "/css/*",
      "/js/*",
      "/fonts/*",
      "/assets/*",
      "/api/*",
      "*.json",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.webp",
      "*.ico",
      "*.xml",
      "*.txt",
      "*.pdf",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot",
      "*.js",
      "*.mjs",
      "*.css",
      "*.map"
    ]
  },
  "routes": [
    {
      "route": "/sitemap.xml",
      "rewrite": "/sitemap.xml"
    },
    {
      "route": "/robots.txt",
      "rewrite": "/robots.txt"
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".xml": "application/xml",
    ".txt": "text/plain"
  },
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": {
      "rewrite": "/index.csr.html",
      "statusCode": 200
    }
  }
}
